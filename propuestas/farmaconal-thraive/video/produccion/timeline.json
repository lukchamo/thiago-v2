  {
   "a": 43.82,
   "b": 46.41,
   "txt": "entre 60 y 90 días."
  },
  {
   "a": 47.28,
   "b": 50.65,
   "txt": "La propuesta de Thraive no reemplaza a SAP Business One."
  },
  {
   "a": 50.76,
   "b": 54.59,
   "txt": "Pone encima una capa operativa donde el caso quirúrgico es el centro:"
  },
  {
   "a": 54.7,
   "b": 57.29,
   "txt": "un solo hilo, de la orden al cobro."
  },
  {
   "a": 57.839,
   "b": 59.749,
   "txt": "Así se ve el ciclo completo."
  },
  {
   "a": 59.979,
   "b": 64.549,
